# SetuHaul: environment template. Placeholders only; copy to .env for local runs and never commit .env.
# All data in this project is synthetic. Real credentials belong in AWS Secrets Manager, not in files.

# ---------------------------------------------------------------- environment
SETUHAUL_ENV=dev                         # dev | eval | staging | pilot (must be set explicitly)
SETUHAUL_ENVIRONMENT=pilot-ap-southeast-2  # deployment evidence is bound to this name
SETUHAUL_DATA_CLASS=synthetic            # required for OpenRouter: synthetic data only

# ---------------------------------------------------------------- booking switch (stays OFF)
SETUHAUL_BOOKING_ENABLED=false           # do not turn on: the six deployment gates must pass first (DEPLOYMENT_GATES.md)
SETUHAUL_DEPLOYMENT_MANIFEST=            # path to the deployment manifest shipped with the build
SETUHAUL_DEPLOYMENT_ID=                  # optional; must equal the id derived from the manifest

# ---------------------------------------------------------------- database and queue
SETUHAUL_DSN=postgresql://<user>:<password>@<host>:5432/<database>
SETUHAUL_TEST_DSN=postgresql://postgres@localhost:55432/postgres   # local test cluster only
SETUHAUL_QUEUE_URL=                      # SQS FIFO queue URL; empty = in-process LocalQueue
SETUHAUL_PROCESSING_LEASE_S=120
FACILITIES=FAC-JAI-01,FAC-GGN-01

# ---------------------------------------------------------------- identity and webhook secrets (placeholders)
COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/<user-pool-id>
COGNITO_CLIENT_IDS=<client-id-1>,<client-id-2>
SESSION_SECRET=<random-32-bytes>
META_APP_SECRET=<meta-app-secret>

# ---------------------------------------------------------------- model provider
SETUHAUL_MODEL_PROVIDER=openrouter       # openrouter (primary, synthetic pilot) | bedrock (optional)
OPENROUTER_API_KEY=<from-secrets-manager>  # local evaluation only; deployed code reads Secrets Manager
SETUHAUL_OR_EXTRACT_MODEL=anthropic/claude-haiku-4.5
SETUHAUL_OR_PHRASE_MODEL=anthropic/claude-sonnet-5   # evaluation only (OD-3: no phrasing model in production)
SETUHAUL_RUN_CAP_USD=0                   # spending cap for a paid run; 0 = no paid calls
SETUHAUL_BEDROCK_REGION=ap-southeast-2

# ---------------------------------------------------------------- local demo
SETUHAUL_DEMO_PORT=8765
SETUHAUL_DEMO_DSN=postgresql://postgres@localhost:55432/postgres
