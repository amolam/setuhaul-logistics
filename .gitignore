*.zip

# Local tool and editor settings
.claude/
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Local test database and unpacked copies used for verification runs
pgdata/
pg.log
unz*/
pt*/

# Build outputs (E0/E5): Lambda artifact and CDK synth
build/
cdk.out/
console/config.json
